{
  "name": "sales-lead-crm-backend",
  "version": "1.0.0",
  "description": "Sales Lead CRM API - lead management, IVR integration, ad webhooks",
  "main": "src/app.js",
  "type": "module",
  "scripts": {
    "build": "prisma generate",
    "dev": "node --watch src/index.js",
    "start": "node src/index.js",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:push": "prisma db push",
    "db:migrate-tenant": "node prisma/apply-multitenant-migration.js && prisma db push",
    "db:migrate-subscription": "node prisma/apply-subscription-migration.js && prisma db push",
    "db:seed": "node prisma/seed.js",
    "db:studio": "prisma studio",
    "db:migrate-ai": "node prisma/apply-ai-layer-migration.js && prisma generate && prisma db push",
    "ai:worker": "node scripts/ai-worker.js"
  },
  "dependencies": {
    "@aws-sdk/client-lambda": "^3.1146.0",
    "@aws-sdk/client-s3": "^3.1146.0",
    "@aws-sdk/s3-request-presigner": "^3.1146.0",
    "@langchain/core": "^0.3.80",
    "@langchain/openai": "^0.5.18",
    "@prisma/client": "^5.22.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "express-validator": "^7.2.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "nodemailer": "^8.0.8",
    "razorpay": "^2.9.6",
    "stripe": "^22.2.0"
  },
  "devDependencies": {
    "prisma": "^5.22.0"
  },
  "prisma": {
    "seed": "node prisma/seed.js"
  }
}
