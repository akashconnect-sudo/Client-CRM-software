generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum UserRole {
  SUPER_ADMIN
  MANAGER
  SALES_EMPLOYEE
}

enum EmployeeStatus {
  ACTIVE
  INACTIVE
}

enum CompanyStatus {
  ACTIVE
  SUSPENDED
}

enum SubscriptionPlan {
  STARTER
  PROFESSIONAL
  ENTERPRISE
}

enum SubscriptionStatus {
  PENDING
  ACTIVE
  EXPIRED
}

enum LeadSource {
  GOOGLE_ADS
  META_ADS
  MANUAL
}

enum LeadStatus {
  NEW
  ASSIGNED
  CONTACTED
  INTERESTED
  FOLLOW_UP
  CONVERTED
  NOT_INTERESTED
  LOST
}

enum CallType {
  INCOMING
  OUTGOING
  MISSED
}

enum CallStatus {
  ANSWERED
  MISSED
  FAILED
  BUSY
}

enum AssignmentMethod {
  ROUND_ROBIN
  MANUAL
}

enum NotificationType {
  LEAD_ASSIGNED
  FOLLOW_UP_REMINDER
  MISSED_FOLLOW_UP
  CALL_RECORDING
  DUPLICATE_LEAD
  ADMIN_NOTICE
  REPORT_SHARED
  AI_JOB_DONE
}

enum AiJobType {
  CALL_ANALYSIS
  PULSE_REASONING
  FOLLOWUP_DRAFT
  ADVISOR_CHAT
  INDEX_DOC
}

enum AiJobStatus {
  PENDING
  RUNNING
  DONE
  FAILED
}

enum SentimentLabel {
  POSITIVE
  NEUTRAL
  NEGATIVE
}

enum ActivityType {
  LEAD_CREATED
  LEAD_ASSIGNED
  STATUS_CHANGED
  NOTE_ADDED
  CALL_MADE
  FOLLOW_UP_SET
  DUPLICATE_SOURCE
  CAMPAIGN_UPDATE
}

model Company {
  id                 String             @id @default(uuid())
  name               String
  gstin              String             @unique
  contactPhone       String?            @map("contact_phone")
  contactEmail       String?            @map("contact_email")
  plan               SubscriptionPlan   @default(STARTER)
  subscriptionStatus SubscriptionStatus @default(PENDING) @map("subscription_status")
  trialEndsAt        DateTime?          @map("trial_ends_at")
  paidAt             DateTime?          @map("paid_at")
  paymentId          String?            @map("payment_id")
  status             CompanyStatus      @default(ACTIVE)
  createdAt          DateTime           @default(now()) @map("created_at")
  updatedAt          DateTime           @updatedAt @map("updated_at")

  users               User[]
  leads               Lead[]
  campaigns           Campaign[]
  callLogs            CallLog[]
  settings            Setting[]
  leadAssignmentState LeadAssignmentState?
  webhookLogs         WebhookLog[]
  subscription            WorkspaceSubscription?
  ivrIntegration          IVRIntegration?
  aiJobs                  AiJob[]
  callRecordingAccesses   CallRecordingAccess[]

  @@map("companies")
}

model User {
  id            String         @id @default(uuid())
  companyId     String         @map("company_id")
  email         String
  passwordHash  String?        @map("password_hash")
  oauthProvider String?        @map("oauth_provider")
  oauthSubject  String?        @map("oauth_subject")
  name          String
  phone         String?
  role          UserRole       @default(SALES_EMPLOYEE)
  department    String?
  ivrAgentId    String?        @map("ivr_agent_id")
  ivrExtension  String?        @map("ivr_extension")
  status        EmployeeStatus @default(ACTIVE)
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")

  company       Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  assignedLeads Lead[]         @relation("AssignedEmployee")
  callLogs      CallLog[]
  followUps     FollowUp[]
  notes         Note[]
  notifications           Notification[]
  aiJobs                  AiJob[]
  callRecordingAccesses   CallRecordingAccess[]

  @@unique([companyId, email])
  @@unique([companyId, oauthProvider, oauthSubject])
  @@index([companyId])
  @@map("users")
}

model Lead {
  id               String     @id @default(uuid())
  companyId        String     @map("company_id")
  leadNumber       Int        @map("lead_number")
  customerName     String     @map("customer_name")
  phone            String
  email            String?
  city             String?
  requirement      String?
  source           LeadSource @default(MANUAL)
  campaignName     String?    @map("campaign_name")
  adSetName        String?    @map("ad_set_name")
  adName           String?    @map("ad_name")
  formName         String?    @map("form_name")
  status           LeadStatus @default(NEW)
  assignedToId     String?    @map("assigned_to_id")
  followUpDate     DateTime?  @map("follow_up_date")
  remarks          String?
  pulseReasoning   String?    @map("pulse_reasoning")
  createdAt        DateTime   @default(now()) @map("created_at")
  updatedAt        DateTime   @updatedAt @map("updated_at")

  company      Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  assignedTo   User?          @relation("AssignedEmployee", fields: [assignedToId], references: [id])
  callLogs     CallLog[]
  followUps    FollowUp[]
  notes        Note[]
  activities   LeadActivity[]
  campaign     Campaign?      @relation(fields: [campaignId], references: [id])
  campaignId   String?        @map("campaign_id")
  aiJobs       AiJob[]

  @@unique([companyId, leadNumber])
  @@index([companyId, phone])
  @@index([companyId, email])
  @@index([companyId, status])
  @@index([companyId, source])
  @@index([companyId, assignedToId])
  @@map("leads")
}

model Campaign {
  id        String     @id @default(uuid())
  companyId String     @map("company_id")
  name      String
  source    LeadSource
  adSetName String?    @map("ad_set_name")
  adName    String?    @map("ad_name")
  formName  String?    @map("form_name")
  createdAt DateTime   @default(now()) @map("created_at")

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  leads   Lead[]

  @@unique([companyId, name, source])
  @@map("campaigns")
}

model CallLog {
  id                String     @id @default(uuid())
  companyId         String     @map("company_id")
  leadId            String?    @map("lead_id")
  employeeId        String?    @map("employee_id")
  customerPhone     String?    @map("customer_phone")
  ivrAgentId        String?    @map("ivr_agent_id")
  callType          CallType   @map("call_type")
  callStatus        CallStatus @map("call_status")
  callStartTime     DateTime   @map("call_start_time")
  callEndTime       DateTime?  @map("call_end_time")
  durationSeconds   Int        @default(0) @map("duration_seconds")
  recordingUrl      String?         @map("recording_url")
  /// Private S3 object key (bucket from RECORDINGS_BUCKET). Must start with `${companyId}/`.
  recordingKey      String?         @map("recording_key")
  transcript        String?
  summary           String?
  sentimentLabel    SentimentLabel? @map("sentiment_label")
  sentimentScore    Float?          @map("sentiment_score")
  ivrProviderCallId String?         @map("ivr_provider_call_id")
  sourceMode        String?         @map("source_mode") // NATIVE_IVR | EXTERNAL_IVR
  provider          String? // AMAZON_CONNECT | EXOTEL | etc.
  externalCallId    String?         @map("external_call_id")
  notes             String?
  isLinked          Boolean         @default(true) @map("is_linked")
  createdAt         DateTime        @default(now()) @map("created_at")

  company             Company               @relation(fields: [companyId], references: [id], onDelete: Cascade)
  lead                Lead?                 @relation(fields: [leadId], references: [id], onDelete: SetNull)
  employee            User?                 @relation(fields: [employeeId], references: [id])
  aiJobs              AiJob[]
  recordingAccesses   CallRecordingAccess[]

  @@index([companyId, customerPhone])
  @@index([companyId, employeeId])
  @@index([companyId, leadId])
  @@index([companyId, externalCallId])
  @@map("call_logs")
}

/// Audit trail when a user plays a call recording (presigned URL issued).
model CallRecordingAccess {
  id        String   @id @default(uuid())
  companyId String   @map("company_id")
  callId    String   @map("call_id")
  userId    String   @map("user_id")
  createdAt DateTime @default(now()) @map("created_at")

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  call    CallLog @relation(fields: [callId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([companyId, callId])
  @@index([companyId, userId])
  @@map("call_recording_accesses")
}

/// Async queue for LangChain / transcription work (too slow for Vercel request limits).
model AiJob {
  id          String      @id @default(uuid())
  companyId   String      @map("company_id")
  type        AiJobType
  status      AiJobStatus @default(PENDING)
  payload     Json
  result      Json?
  error       String?
  leadId      String?     @map("lead_id")
  callLogId   String?     @map("call_log_id")
  requestedBy String?     @map("requested_by")
  startedAt   DateTime?   @map("started_at")
  completedAt DateTime?   @map("completed_at")
  createdAt   DateTime    @default(now()) @map("created_at")
  updatedAt   DateTime    @updatedAt @map("updated_at")

  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  lead      Lead?    @relation(fields: [leadId], references: [id], onDelete: SetNull)
  callLog   CallLog? @relation(fields: [callLogId], references: [id], onDelete: SetNull)
  requester User?    @relation(fields: [requestedBy], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([companyId, type])
  @@index([callLogId])
  @@index([leadId])
  @@map("ai_jobs")
}

model WorkspaceSubscription {
  id                   String   @id @default(uuid())
  companyId            String   @unique @map("company_id")
  modules              String[] // LEADS, IVR
  tier                 String // STARTER | PROFESSIONAL | ENTERPRISE
  billingCycleMonths   Int      @default(3) @map("billing_cycle_months")
  pricePerMonth        Decimal  @default(0) @map("price_per_month") @db.Decimal(12, 2)
  // Purchased seats beyond tier included cap (legacy; prefer seatCount)
  extraSeats           Int      @default(0) @map("extra_seats")
  // Billable seat allotment (per-user pricing). Invoice uses this count.
  seatCount            Int      @default(1) @map("seat_count")
  startedAt            DateTime @default(now()) @map("started_at")
  renewsAt             DateTime @map("renews_at")
  status               String   @default("TRIAL") // TRIAL | ACTIVE | PAST_DUE | CANCELLED
  razorpayPaymentId    String?  @map("razorpay_payment_id")
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt @map("updated_at")

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@map("workspace_subscriptions")
}

model IVRIntegration {
  id            String    @id @default(uuid())
  companyId     String    @unique @map("company_id")
  mode          String // NATIVE | EXTERNAL
  provider      String? // AMAZON_CONNECT | EXOTEL | KNOWLARITY | OZONETEL | MYOPERATOR | OTHER
  apiKey        String?   @map("api_key")
  apiSecret     String?   @map("api_secret")
  instanceId    String?   @map("instance_id")
  webhookSecret String    @map("webhook_secret")
  status        String    @default("PENDING_VERIFICATION") // PENDING_VERIFICATION | CONNECTED | ERROR
  lastSyncedAt  DateTime? @map("last_synced_at")
  lastError     String?   @map("last_error")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@map("ivr_integrations")
}

model FollowUp {
  id          String    @id @default(uuid())
  leadId      String    @map("lead_id")
  employeeId  String    @map("employee_id")
  scheduledAt DateTime  @map("scheduled_at")
  remarks     String?
  isCompleted Boolean   @default(false) @map("is_completed")
  completedAt DateTime? @map("completed_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  lead     Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)
  employee User @relation(fields: [employeeId], references: [id])

  @@index([scheduledAt])
  @@index([employeeId])
  @@map("follow_ups")
}

model Note {
  id        String   @id @default(uuid())
  leadId    String   @map("lead_id")
  authorId  String   @map("author_id")
  content   String
  createdAt DateTime @default(now()) @map("created_at")

  lead   Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)
  author User @relation(fields: [authorId], references: [id])

  @@map("notes")
}

model Notification {
  id        String           @id @default(uuid())
  userId    String           @map("user_id")
  type      NotificationType
  title     String
  message   String
  leadId    String?          @map("lead_id")
  callId    String?          @map("call_id")
  isRead    Boolean          @default(false) @map("is_read")
  createdAt DateTime         @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@map("notifications")
}

model LeadActivity {
  id          String       @id @default(uuid())
  leadId      String       @map("lead_id")
  type        ActivityType
  description String
  metadata    Json?
  createdAt   DateTime     @default(now()) @map("created_at")

  lead Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([leadId])
  @@map("lead_activities")
}

model WebhookLog {
  id        String   @id @default(uuid())
  companyId String?  @map("company_id")
  provider  String
  payload   Json
  status    String
  message   String?
  createdAt DateTime @default(now()) @map("created_at")

  company Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)

  @@map("webhook_logs")
}

model Setting {
  id        String   @id @default(uuid())
  companyId String   @map("company_id")
  key       String
  value     String
  updatedAt DateTime @updatedAt @map("updated_at")

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, key])
  @@map("settings")
}

model LeadAssignmentState {
  companyId        String  @id @map("company_id")
  lastEmployeeId   String? @map("last_employee_id")

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@map("lead_assignment_state")
}

model AuthOtpChallenge {
  id        String   @id @default(uuid())
  email     String
  purpose   String   @default("auth")
  otpHash   String   @map("otp_hash")
  verified  Boolean  @default(false)
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([email, verified])
  @@map("auth_otp_challenges")
}
